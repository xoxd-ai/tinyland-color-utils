{
  "name": "@tummycrypt/tinyland-color-utils",
  "version": "1.0.0",
  "private": true,
  "description": "Pure JavaScript color utilities with WCAG contrast validation, color space conversions, and caching",
  "type": "module",
  "license": "(Zlib AND LicenseRef-Tinyland-Proprietary)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/utils/color/types.d.ts",
      "import": "./dist/utils/color/types.js"
    },
    "./cache": {
      "types": "./dist/utils/color/cache.d.ts",
      "import": "./dist/utils/color/cache.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "color",
    "wcag",
    "contrast",
    "accessibility",
    "a11y",
    "oklch",
    "oklab"
  ],
  "author": "Tinyland Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyland-color-utils.git"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@types/node": "^22.0.0",
    "fast-check": "^4.10.2",
    "publint": "^0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/xoxd-ai/tinyland-color-utils",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyland-color-utils/issues"
  }
}
